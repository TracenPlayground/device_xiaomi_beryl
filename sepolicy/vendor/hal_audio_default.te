allow hal_audio_default audio_socket:sock_file rw_file_perms;
allow hal_audio_default sysfs_audio_pa:dir search;
allow hal_audio_default sysfs_audio_pa:file r_file_perms;
allow hal_audio_default sysfs_headset:file r_file_perms;

allow hal_audio_default persist_data_file:dir search;
allow hal_audio_default sysfs_batteryinfo:dir r_dir_perms;
allow hal_audio_default sysfs_batteryinfo:file r_file_perms;
allow hal_audio_default sysfs_power_supply:file r_file_perms;
set_prop(hal_audio_default, vendor_mtk_audio_prop)

# Dolby
binder_call(hal_audio_default, hal_dms_default)
allow hal_audio_default hal_dms_hwservice:hwservice_manager find;
allow hal_audio_default hal_dms_aidl_service:service_manager find;
