r_dir_file(hal_health_default, sysfs_power_supply)

allow hal_health_default sysfs_power_supply:file rw_file_perms;

# Bypass charging: input_suspend node under battery is labeled sysfs_batteryinfo,
# not sysfs_power_supply — grant explicitly
allow hal_health_default sysfs_batteryinfo:file rw_file_perms;
allow hal_health_default sysfs_batteryinfo:dir r_dir_perms;
